# Security: Secret token to protect your API and Web UI (optional, leave empty for local dev)
API_KEY=my_super_secret_token_change_me

# Optional: If you prefer using pure Gemini API Key instead of mounting ~/.gemini
# GEMINI_API_KEY=AIzaSy...

# Paths to mount into the Docker container
# Default is your user's ~/.gemini directory (contains Antigravity login token and session history)
GEMINI_DATA_PATH=~/.gemini

# Path to the workspace directory where Antigravity will work on code
WORKSPACE_PATH=./workspace

# WhatsApp Integration Settings
# Phone numbers authorized to talk to the bot (comma-separated, ex: 33612345678,33766817354)
ALLOWED_NUMBERS=

# Official Meta WhatsApp Cloud API credentials (from developers.facebook.com)
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_VERIFY_TOKEN=antigravity_token

# Optional: If using the Tailscale Docker sidecar service
# TAILSCALE_AUTHKEY=tskey-auth-...
